FROM public.ecr.aws/lambda/python:3.9

# Set the working directory to /var/task
WORKDIR /var/task

# Install dependencies
COPY requirements2.txt . 
RUN pip3 install --no-cache-dir -r requirements2.txt --target "${LAMBDA_TASK_ROOT}"

# Copy the application files, including the `api` folder
COPY . /var/task/

# Set the CMD to your handler (module.function)
CMD [ "api.lambda_handler.handler" ]
